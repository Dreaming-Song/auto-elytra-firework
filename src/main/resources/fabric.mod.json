{
  "schemaVersion": 1,
  "id": "autoelytra",
  "version": "${version}",
  "name": "Auto Elytra Firework",
  "description": "Auto Elytra Firework — 在鞘翅飞行时按空格(可改键)自动从背包取用烟花加速,使用后自动还原原手持物品;支持在模组菜单中设置保留数量、使用顺序与烟花类型。",
  "icon": "assets/autoelytra/icon.png",
  "authors": [
    "梦歌"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.metrodata.autoelytra.AutoElytraBoost"
    ],
    "modmenu": [
      "net.metrodata.autoelytra.gui.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.2",
    "fabric-api": "*",
    "minecraft": "~26.2-",
    "java": ">=25",
    "modmenu": ">=20.0.1",
    "cloth-config": ">=26.2"
  }
}
